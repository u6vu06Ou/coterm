{
  "name": "coterm",
  "version": "1.5.74",
  "description": "Coterm is a Windows-first workspace for coding agents, conversations, and terminal panes.",
  "main": "out/main/index.js",
  "author": "Coterm contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run check:ui-actions && npm run test && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:stable": "npm run build && electron-builder --win nsis",
    "dist:beta": "npm run build && electron-builder --win nsis --config electron-builder.beta.json",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "playwright test tests/e2e/bdd",
    "test:bdd:voice": "playwright test tests/e2e/bdd/voice.spec.ts",
    "test:voice:live": "tsx scripts/verify-live-stt.ts",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "browser:mcp": "tsx scripts/browser-mcp.ts",
    "test:ui:audit": "npm run build && playwright test tests/e2e/ui-action-audit.spec.ts",
    "test:ui:total": "tsx scripts/run-ui-total.ts",
    "test:ui:total:strict": "tsx scripts/run-ui-total.ts --strict --baseline tests/fixtures/ui-total-release-baseline.json",
    "test:ui:total:complete": "tsx scripts/run-ui-total.ts --strict",
    "audit:ui-actions": "tsx scripts/audit-ui-actions.ts",
    "check:ui-actions": "tsx scripts/audit-ui-actions.ts --check",
    "test:packaged": "npm run build:unpack && set COTERM_PACKAGED_E2E=1&& playwright test --grep packaged",
    "ci:quality": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:coverage && npm run security:scan",
    "ci:bdd": "npm run build && npm run test:bdd",
    "verify": "npm run ci:quality",
    "security:scan": "tsx scripts/scan-secrets.ts",
    "release:check": "tsx scripts/release-checklist.ts",
    "assets:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "protocol:codex": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-codex-protocol.ps1",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.185",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/lxgw-wenkai-mono-tc": "^5.3.0",
    "@livekit/rtc-node": "^0.13.33",
    "@lydell/node-pty": "1.2.0-beta.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "6.1.0-beta.302",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "2.17.0",
    "playwright": "1.61.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "smol-toml": "^1.9.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/cascadia-code": "^5.2.2",
    "@fontsource-variable/noto-sans-tc": "^5.2.10",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.5.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.18.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "build": {
    "appId": "io.coterm.app",
    "productName": "Coterm",
    "asar": true,
    "asarUnpack": [
      "node_modules/@lydell/node-pty/**",
      "node_modules/@livekit/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/smol-toml/dist/index.cjs",
        "to": "codex-team/smol-toml.cjs"
      },
      {
        "from": "tools/codex-team",
        "to": "codex-team",
        "filter": [
          "*.mjs",
          "*.example"
        ]
      },
      {
        "from": "tools/coterm-at",
        "to": "coterm-at",
        "filter": [
          "*.md"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk/browser-sdk.js",
      "!node_modules/@anthropic-ai/claude-agent-sdk/bridge.mjs",
      "!node_modules/@anthropic-ai/claude-agent-sdk/extractFromBunfs.js",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.d.mts",
      "!**/node_modules/**/*.d.cts",
      "!**/node_modules/**/{test,tests,spec,specs,__tests__,__mocks__,fixtures,coverage,lcov-report,tmp}/**",
      "!**/node_modules/**/*.{test,spec}.{js,ts,mjs,cjs}",
      "!**/node_modules/**/{README,CHANGELOG,AUTHORS,CONTRIBUTING,LICENSE}*",
      "!node_modules/@livekit/local-inference/**",
      "!node_modules/@livekit/local-inference-win32-x64-msvc/**",
      "!node_modules/@img/sharp-wasm32/**",
      "!node_modules/@img/sharp-webcontainers-wasm32/**"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "win": {
      "icon": "resources/icon.ico",
      "electronLanguages": [
        "en-US",
        "zh-TW"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
